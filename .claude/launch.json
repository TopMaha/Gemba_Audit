{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "gemba-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 8080
    },
    {
      "name": "gemba-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview"
      ],
      "port": 8080
    },
    {
      "name": "gemba-preview-ghpages",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--",
        "--base=/Gemba_Audit/",
        "--port",
        "8081"
      ],
      "port": 8081
    }
  ]
}
